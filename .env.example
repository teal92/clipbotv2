# Reference values. Set these in hosting secrets/environment; this file is not loaded automatically.
CLIPBOT_ORIGIN=https://clipbot.your-domain.example
CLIPBOT_LOCAL_SIGNUP=0
CLIPBOT_GLOBAL_MONTHLY_USD=400
CLIPBOT_GLOBAL_DAILY_USD=20
# Keep private. This key does not enable paid AI dispatch.
# ANTHROPIC_API_KEY=

# Stripe price IDs from YOUR Stripe account (create your own products and prices). Use test mode first.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_PRO=price_...
# Stripe secrets belong only in the hosting environment, never in this reference file.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Staged production credentials: never replace sandbox fields above.
# Any live namespace field selects the entire namespace; partial configuration fails closed.
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
# STRIPE_LIVE_PRICE_STARTER=
# STRIPE_LIVE_PRICE_CREATOR=
# STRIPE_LIVE_PRICE_PRO=
# STRIPE_LIVE_PORTAL_CONFIGURATION=
# Custom uses exactly sixteen precreated USD/month price buckets, $10 through $85.
# STRIPE_CUSTOM_PRODUCT=
# STRIPE_CUSTOM_PRICES={"1000":"price_...","1500":"price_...",...}
# STRIPE_LIVE_CUSTOM_PRODUCT=
# STRIPE_LIVE_CUSTOM_PRICES={"1000":"price_...","1500":"price_...",...}
# Live activation requires separate acceptance after configuration and lifecycle checks.
CLIPBOT_BILLING_MODE=test
CLIPBOT_LIVE_BILLING_ACCEPTED=false

# Existing owner account ID only; do not put an email or password here. Empty disables admin access.
# CLIPBOT_ADMIN_USER_ID=

# Developer-app IDs from YOUR Twitch/Kick/Meta/TikTok developer accounts. Authorization needs the matching secrets and a token encryption key.
# TWITCH_CLIENT_ID=your-value-here
# KICK_CLIENT_ID=your-value-here
# META_APP_ID=your-value-here
# TIKTOK_CLIENT_KEY=your-value-here
# Client secrets must be entered directly into hosting secrets, never committed.
# TWITCH_CLIENT_SECRET=
# KICK_CLIENT_SECRET=
# META_APP_SECRET=
# TIKTOK_CLIENT_SECRET=

# Generate once in the private Render Shell; keep this key stable and back it up securely.
# CLIPBOT_TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=v24.0
# Add these exact callback addresses to each of your developer apps:
# https://clipbot.your-domain.example/api/connections/twitch/callback
# https://clipbot.your-domain.example/api/connections/kick/callback
# https://clipbot.your-domain.example/api/connections/tiktok/callback
# https://clipbot.your-domain.example/api/connections/instagram/callback
# https://clipbot.your-domain.example/api/connections/facebook/callback

# Set only after an approved real installer download is hosted. No secrets here.
# CLIPBOT_COMPANION_DOWNLOAD_URL=
# CLIPBOT_COMPANION_VERSION=0.2.0-beta
# CLIPBOT_COMPANION_SHA256=
